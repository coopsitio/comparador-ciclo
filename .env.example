# Plantilla de configuracion. NO pongas datos reales aqui.
#
# Como se usa:
#   1. Copia este archivo y renombralo a  .env
#   2. En el .env pon tus datos locales reales
#   3. El .env real esta en .gitignore, asi que NUNCA se sube a GitHub
#
# Solo se necesita si vas a comparar contra bases Oracle (fuentes .sql).
# Para el modo de ejemplo (CSV) no hace falta.

# --- V7 (produccion, solo consulta) ---
# Oracle 11.2 -> requiere modo thick (ver ORACLE_CLIENT_LIB abajo).
ORACLE_V7_USER=tu_usuario_v7
ORACLE_V7_PASSWORD=tu_password_v7
ORACLE_V7_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=host_v7)(PORT=1522))(CONNECT_DATA=(SID=SID_V7)))

# --- V8 (pruebas) ---
ORACLE_V8_USER=tu_usuario_v8
ORACLE_V8_PASSWORD=tu_password_v8
ORACLE_V8_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=host_v8)(PORT=1522))(CONNECT_DATA=(SID=SID_V8)))

# --- Instant Client (modo thick) ---
# Ruta a un Instant Client 19. Obligatorio para conectarse a V7 (Oracle 11.2).
# Sirve tambien para V8 (19c). Si solo comparas V8, puedes dejarlo vacio (usa thin).
ORACLE_CLIENT_LIB=D:\ruta\a\instantclient_19_31
